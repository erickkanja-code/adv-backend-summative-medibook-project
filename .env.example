# Copy this file to .env and fill in your own values. Never commit .env.

# Web server
PORT=3000

# MySQL (schema.sql creates the database named below)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=medibook
DB_PASSWORD=change_me
DB_NAME=medibook
DB_CONNECTION_LIMIT=10

# Redis (used by the waitlist and notification queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Audit log file (relative to the project root, or an absolute path)
AUDIT_LOG_PATH=logs/audit.log
